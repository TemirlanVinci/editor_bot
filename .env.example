# ==============================================================================
# КОНФИГУРАЦИЯ СЕРВЕРА (ПРОИЗВОДСТВЕННЫЙ ДЕПЛОЙ)
# Скопируйте данный файл в .env и укажите ваши боевые значения
# ==============================================================================

# --- База данных PostgreSQL ---
POSTGRES_USER=editor_db_user
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=editor_video_db

# --- Telegram Bot ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Необязательно: список ID администраторов через запятую для защиты бота
# ADMIN_IDS=123456789,987654321
# Локальный Telegram Bot API сервер (если используется для загрузки файлов > 50MB)
TELEGRAM_LOCAL_SERVER=

# --- Внутренняя безопасность (Bot <-> Backend) ---
# Секретный ключ для заголовка X-Bot-Secret (сгенерируйте случайную строку)
BOT_SECRET=generate_a_random_long_secret_string_here

# --- LLM / Ollama ---
LLM_API_URL=http://llm:11434
# qwen3.5:4b (в 4-битном квантовании Q4_K_M для GPU RTX 3050 6GB)
QWEN_MODEL_NAME=qwen3.5:4b
LLM_API_KEY=
LLM_TIMEOUT_SECS=300
LLM_NUM_CTX=16384
LLM_TEMPERATURE=0.1

# --- Распознавание Whisper ---
# large-v3-turbo-q5_0 (~574MB, Q5_0 квантованная, рекомендуется) / small (~466MB) / base (~142MB)
WHISPER_MODEL=large-v3-turbo-q5_0
WHISPER_MODEL_PATH=/app/models/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=ru
WHISPER_USE_GPU=true

# --- Воркер автопостинга ---
# Интервал опроса очереди в секундах
WORKER_POLL_INTERVAL=60

# --- Часовой пояс планирования публикаций ---
# Смещение часового пояса для слотов времени (например, +05:00 для Астаны/Екатеринбурга, +03:00 для Москвы)
SCHEDULE_TZ_OFFSET=+05:00

# --- Обработка голоса (Demucs v4 + CosyVoice 3) ---
# URL микросервиса очистки вокала и переозвучки
VOICE_SERVICE_URL=http://voice_service:8082
# Флаг включения переозвучки CosyVoice 3 (true/false)
ENABLE_VOICE_CONVERSION=true
# Флаг включения очистки речи от фоновой музыки через Demucs v4 (true/false)
ENABLE_DEMUCS=true
# Устройство для Demucs: cuda (рекомендуется для быстрого инференса) или cpu
DEMUCS_DEVICE=cuda
# Путь к весам модели CosyVoice 3
COSYVOICE_MODEL_DIR=/app/models/CosyVoice-300M
